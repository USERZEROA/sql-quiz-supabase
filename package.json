{
  "name": "sql-quiz-supabase",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "check:db": "tsx scripts/check-db.ts",
    "check:audit": "tsx scripts/check-audit.ts",
    "check:all": "npm run check && npm run check:db && npm run check:audit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "pgsql-ast-parser": "^12.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
